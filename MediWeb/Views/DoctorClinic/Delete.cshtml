@using DataLayer;
@model IEnumerable<DoctorClinics>

@{
    ViewData["Title"] = "Doctor works at";
}

<h1 class="my-4">Doctor's workplaces</h1>

<table class="table table-hover table-striped">
    <thead class="table-dark">
        <tr>
            <th scope="col">Doctor</th>
            <th scope="col">Clinic</th>
            <th scope="col">Specialization</th>
            <th scope="col" class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doctorClinic in Model)
        {
            <tr>
                <td>@(doctorClinic.Doctor.UserAccount.FirstName + " " + doctorClinic.Doctor.UserAccount.LastName)</td>
                <td>@doctorClinic.Clinic.Name</td>
                <td>@doctorClinic.Specialization.SpecializationName</td>
                <td class="text-end">
                    <a asp-controller="DoctorClinic" asp-action="Delete" asp-route-id="@doctorClinic" class="btn btn-sm btn-warning">Delete Work Clinics</a>
                </td>
            </tr>
        }
    </tbody>
</table>
