@using DataLayer;
@model IEnumerable<DoctorClinics>

@{
    ViewData["Title"] = "Doctor's workplaces";
}

<h1 class="my-4">Doctor's workplaces</h1>

<table class="table table-hover table-striped">
    <thead class="table-dark">
        <tr>
            <th scope="col">Doctor</th>
            <th scope="col">Clinic</th>
            <th scope="col">Specialization</th>
            <th scope="col">Note</th>
            <th scope="col" class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doctorClinic in Model)
        {
            <tr>
                <td>@(doctorClinic.Doctor?.UserAccount.FirstName + " " + doctorClinic.Doctor?.UserAccount.LastName)</td>
                <td>@doctorClinic.Clinic?.Name</td>
                <td>@doctorClinic.Specialization?.SpecializationName</td>
                <td>@doctorClinic.Note</td>
                <td class="text-end">
                <form method="post" asp-controller="DoctorClinic" asp-action="DeleteConfirmed"
                    asp-route-doctorId="@doctorClinic.DoctorId"
                    asp-route-clinicId="@doctorClinic.ClinicId"
                    asp-route-specializationId="@doctorClinic.SpecializationId">
                        <input type="submit" class="btn btn-danger" value="Delete workplace"/>
                </form>
                </td>
            </tr>
        }      
    </tbody>
</table>
<a asp-controller="Doctor" asp-action="Index" class="btn btn-secondary">Back to Doctors</a>
