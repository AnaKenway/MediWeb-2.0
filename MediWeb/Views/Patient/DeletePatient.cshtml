@model PatientDetailsViewModel

@{
    ViewData["Title"] = "Delete Patient";
}

<h1 class="my-4">Delete Patient</h1>

<h4 class="mb-3">Are you sure you want to delete this Patient?</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-3">First Name</dt>
            <dd class="col-sm-9">@Model.FirstName</dd>

            <dt class="col-sm-3">Last Name</dt>
            <dd class="col-sm-9">@Model.LastName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Jmbg</dt>
            <dd class="col-sm-9">@Model.Jmbg</dd>

            <dt class="col-sm-3">Date of Birth</dt>
            <dd class="col-sm-9">@Model.DateOfBirth</dd>

            <dt class="col-sm-3">Phone Number</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>
        </dl>
        <form asp-action="DeletePatientConfirmed" asp-route-patientId="@Model.Id">
            <div class="d-grid gap-2">
                <input type="submit" value="Delete" class="btn btn-danger" />
                <a asp-action="ListPatients" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
